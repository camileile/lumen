{
  "manifest_version": 3,
  "name": "Lumen",
  "version": "1.0.0",
  "description": "Sinais automatizados sobre fontes para apoiar uma navegação mais consciente",

  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://localhost:3000/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon-verde.png"
    }
  },

  "icons": {
    "128": "icon-verde.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["score-contract.js", "handshake-policy.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "lume-verde.gif",
        "lume-amarelo.gif",
        "lume-vermelho.gif"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
