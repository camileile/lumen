{
  "name": "lumen-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:clean": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "test:compile": "npm run test:clean && tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/test/dashboardData.test.js .test-dist/test/api.test.js",
    "test:coverage": "npm run test:compile && node --experimental-test-coverage --test-coverage-include=.test-dist/src/app/lib/*.js --test .test-dist/test/dashboardData.test.js .test-dist/test/api.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "next": "16.3.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5"
  }
}
