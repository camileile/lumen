{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".test-dist",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "src/app/lib/api.ts",
    "src/app/lib/dashboardData.ts",
    "src/app/lib/extensionAuth.ts",
    "src/app/lib/ui.ts",
    "src/app/lib/site-navigation.ts",
    "src/app/lib/types.ts",
    "src/app/components/auth-controls.tsx",
    "src/app/dashboard/components/tutorial-dialog.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ],
  "exclude": ["node_modules", ".next", ".test-dist"]
}
