{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2020",
   "module": "Node16",
  "moduleResolution": "node16",

    "strict": true,
    "esModuleInterop": true,

    "types": ["node"],
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src", "prisma/generated"]
}