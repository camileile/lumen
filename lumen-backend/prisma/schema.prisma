generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  name      String     @default("")
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())

  analyses  Analysis[]
  extensionSessions ExtensionSession[]
}

model Analysis {
  id        String   @id @default(uuid())
  url       String
  domain    String
  category  String
  score     Int
  summary   String
  text      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], map: "Analysis_userId_createdAt_idx")
  @@index([userId, url, createdAt], map: "Analysis_userId_url_createdAt_idx")
}

model ExtensionSession {
  id               String   @id @default(uuid())
  installationId   String
  refreshTokenHash String   @unique
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId], map: "ExtensionSession_userId_installationId_key")
  @@index([userId, revokedAt, createdAt], map: "ExtensionSession_userId_revokedAt_createdAt_idx")
}
