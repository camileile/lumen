# Local server
PORT=3000
CORS_ORIGIN=http://localhost:3001
REQUEST_BODY_LIMIT=16kb
TRUST_PROXY_HOPS=

# Per-process abuse controls (use a shared store when horizontally scaling)
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_ANALYZE_MAX=20
RATE_LIMIT_ANALYZE_WINDOW_SECONDS=60
RATE_LIMIT_EXTENSION_AUTHORIZE_MAX=10
RATE_LIMIT_EXTENSION_AUTHORIZE_WINDOW_SECONDS=300
RATE_LIMIT_EXTENSION_EXCHANGE_MAX=20
RATE_LIMIT_EXTENSION_EXCHANGE_WINDOW_SECONDS=300
ANALYZE_DUPLICATE_WINDOW_SECONDS=30

# Prisma (local development)
DATABASE_URL="file:./prisma/dev.db"

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret
JWT_ISSUER=lumen-api
JWT_AUDIENCE=lumen-web-extension

# OpenRouter (optional; the backend falls back to local domain rules when absent)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SITE_URL="http://localhost:3001"
OPENROUTER_APP_NAME="Lumen"
